PORT=3000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=water_reports
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Para un proveedor real, completar ambos valores. En Mailpit se dejan vacios.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Municipio <reportes@municipio.test>
MAINTENANCE_EMAIL=cuadrilla@municipio.test

# AWS: credenciales solo en .env local, nunca en el repositorio ni en la imagen.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales; omitir si no aplica.
AWS_SESSION_TOKEN=

# Debe coincidir con el GitHub Secret DOCKER_USER. No poner aquí el token.
DOCKER_USER=
