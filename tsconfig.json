{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "outDir": "./dist",
    "sourceMap": true, "strict": true, "esModuleInterop": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
